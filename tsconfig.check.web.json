{
  "extends": "./apps/web/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "incremental": false,
    "noEmit": true,
    "paths": {
      "@/*": ["apps/web/src/*"],
      "@aufnehmen/contracts": ["packages/contracts/src/index.ts"],
      "@aufnehmen/testing": ["packages/testing/src/index.ts"]
    }
  },
  "include": [
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "apps/web/.next/types/**/*.ts",
    "apps/web/.next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "apps/web/.next/cache"]
}
