# Local development only. Real overrides belong in the ignored apps/api/.env.local.
# Set NODE_ENV in the process environment; local files cannot change the runtime mode.
HOST=127.0.0.1
PORT=4000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
TRUST_PROXY=false
MONGODB_URI=mongodb://127.0.0.1:27018/aufnehmen_dev?replicaSet=rs0&directConnection=true

# Integration tests never read or fall back to MONGODB_URI.
MONGODB_TEST_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
