{
  "name": "aufnehmen",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A TypeScript MENN foundation with a portable AI engineering workflow.",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.25.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "build:api": "pnpm run build && pnpm --filter aufnehmen-api run build",
    "build:web": "pnpm run build && pnpm --filter aufnehmen-web run build",
    "dev": "pnpm run build && node --import tsx tooling/dev/run-services.ts all",
    "dev:api": "pnpm run build && node --import tsx tooling/dev/run-services.ts api",
    "dev:web": "pnpm run build && node --import tsx tooling/dev/run-services.ts web",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web && pnpm run typecheck:tooling",
    "typecheck:node": "tsc --noEmit -p tsconfig.check.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.check.web.json",
    "typecheck:tooling": "tsc --noEmit -p tooling/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm --filter aufnehmen-api run test:integration",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @accessibility",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch:check": "node --import tsx tooling/architecture/check-architecture.ts",
    "config:check": "node --import tsx tooling/config/check-config.ts",
    "tooling:check": "node .ai/tools/check.mjs",
    "setup:check": "node --import tsx tooling/config/check-setup.ts",
    "docs:check": "node --import tsx tooling/docs/check-links.ts",
    "infra:up": "node --import tsx tooling/infra/mongodb.ts up",
    "infra:status": "node --import tsx tooling/infra/mongodb.ts status",
    "infra:down": "node --import tsx tooling/infra/mongodb.ts down",
    "api:openapi": "node tooling/api/run-openapi.mjs write",
    "api:openapi:check": "node tooling/api/run-openapi.mjs check",
    "security:secrets": "node --import tsx tooling/security/check-secrets.ts",
    "security:dependency-policy": "node --import tsx tooling/security/check-dependencies.ts",
    "security:dependency-audit": "pnpm audit --audit-level high",
    "security:dependencies": "pnpm run security:dependency-policy && pnpm run security:dependency-audit",
    "check:quick": "node --import tsx tests/run-quality-gates.ts quick",
    "check:all": "node --import tsx tests/run-quality-gates.ts all"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
