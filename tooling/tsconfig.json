{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "..",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": "..",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@aufnehmen/contracts": ["packages/contracts/src/index.ts"],
      "@aufnehmen/testing": ["packages/testing/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "../tests/**/*.ts", "../vitest.config.ts", "../playwright.config.ts"]
}
